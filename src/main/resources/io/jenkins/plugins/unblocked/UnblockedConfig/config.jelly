<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form">
    <f:entry title="Disable Unblocked">
        <f:checkbox field="disabled" id="unblocked-disabled"/>
    </f:entry>
    <div id="unblocked-signature">
        <f:entry title="Signature" field="signature">
            <f:password/>
        </f:entry>
    </div>
    <script src="${rootURL}/plugin/unblocked/js/config.js"></script>
</j:jelly>
